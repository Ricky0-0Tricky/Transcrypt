                <Component class="javax.swing.JTextArea" name="aboutTextArea">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="rows" type="int" value="8"/>
                    <Property name="text" type="java.lang.String" value="                                      Morse Code Translator&#xa;&#xa;-Purpose/Development of the App&#xa;&#xa;This app pretends to translate natural language to morse code and&#xa;vice-versa so any person, when in need of such tool, can do it &#xa;without constraints of Network or Hardware.&#xa;&#xa;-How to use it?&#xa;&#xa;This app is pretty simple to operate being that the user can either &#xa;write himself the text or morse code that wants translated or can &#xa;submit a text file to translate itself. Apart from that there is also the&#xa;option to listen/see the message being transmited in real time."/>
                    <Property name="focusable" type="boolean" value="false"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
          </SubComponents>
